pipeline {
    agent any

    tools {
        nodejs 'nodejs'
    }

    environment {
        // Jenkins Tools
        SCANNER_HOME = tool 'sonar-scanner'

        // AWS ECR
        AWS_ACCOUNT_ID = credentials('ACCOUNT_ID')
        AWS_ECR_REPO_NAME = credentials('ECR_REPO1')
        AWS_DEFAULT_REGION = 'ap-south-1'

        REPOSITORY_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"

        // GitHub
        GIT_REPO_NAME = 'End-to-End-Kubernetes-Three-Tier-DevSecOps-Project'
        GIT_USER_NAME = 'MohamedSaabith342'
        GIT_USER_EMAIL = 'e21342@eng.pdn.ac.lk'
        GIT_BRANCH = 'master'
    }

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from GitHub') {
            steps {
                git branch: "${GIT_BRANCH}",
                    credentialsId: 'GITHUB',
                    url: 'https://github.com/MohamedSaabith342/End-to-End-Kubernetes-Three-Tier-DevSecOps-Project.git'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('Application-Code/frontend') {
                    withSonarQubeEnv('sonar-server') {
                        sh '''
                            "$SCANNER_HOME/bin/sonar-scanner" \
                                -Dsonar.projectName=three-tier-frontend \
                                -Dsonar.projectKey=three-tier-frontend \
                                -Dsonar.sources=.
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate(
                        abortPipeline: true,
                        credentialsId: 'sonar_token'
                    )
                }
            }
        }

        // stage('OWASP Dependency-Check Scan') {
        //     steps {
        //         dir('Application-Code/frontend') {
        //             dependencyCheck(
        //                 additionalArguments: '--scan ./ --disableYarnAudit --disableNodeAudit',
        //                 odcInstallation: 'DP-Check'
        //             )

        //             dependencyCheckPublisher(
        //                 pattern: '**/dependency-check-report.xml'
        //             )
        //         }
        //     }
        // }

        // stage('Trivy Filesystem Scan') {
        //     steps {
        //         dir('Application-Code/frontend') {
        //             sh '''
        //                 trivy fs \
        //                     --severity HIGH,CRITICAL \
        //                     --exit-code 1 \
        //                     --output trivyfs.txt \
        //                     .
        //             '''
        //         }
        //     }
        // }

        stage('Docker Image Build') {
            steps {
                dir('Application-Code/frontend') {
                    sh '''
                        docker build \
                            -t "${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}" \
                            .
                    '''
                }
            }
        }

        // stage('Trivy Docker Image Scan') {
        //     steps {
        //         sh '''
        //             trivy image \
        //                 --severity HIGH,CRITICAL \
        //                 --exit-code 1 \
        //                 --output trivyimage.txt \
        //                 "${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}"
        //         '''
        //     }
        // }

        stage('Push Image to AWS ECR') {
            steps {
                sh '''
                    set -e

                    aws ecr get-login-password \
                        --region "${AWS_DEFAULT_REGION}" |
                    docker login \
                        --username AWS \
                        --password-stdin "${REPOSITORY_URI}"

                    docker tag \
                        "${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}" \
                        "${REPOSITORY_URI}/${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}"

                    docker push \
                        "${REPOSITORY_URI}/${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}"
                '''
            }
        }

        stage('Update Kubernetes Deployment') {
            steps {
                dir('Kubernetes-Manifests-file/Frontend') {
                    withCredentials([
                        gitUsernamePassword(
                            credentialsId: 'GITHUB',
                            gitToolName: 'Default'
                        )
                    ]) {
                        sh '''
                            set -e

                            git config user.name "${GIT_USER_NAME}"
                            git config user.email "${GIT_USER_EMAIL}"

                            python3 - <<'PY'
import os
import re
from pathlib import Path

deployment_file = Path("deployment.yaml")

content = deployment_file.read_text()

account = os.environ["AWS_ACCOUNT_ID"]
region = os.environ["AWS_DEFAULT_REGION"]
repo = os.environ["AWS_ECR_REPO_NAME"]
tag = os.environ["BUILD_NUMBER"]

new_image = (
    f"{account}.dkr.ecr.{region}.amazonaws.com/"
    f"{repo}:{tag}"
)

pattern = (
    r"(?m)^(\\s*image:\\s*)"
    r"[^\\s#]*" + re.escape(repo) + r":[^\\s#]+"
)

updated_content, count = re.subn(
    pattern,
    lambda match: match.group(1) + new_image,
    content
)

if count != 1:
    raise SystemExit(
        f"Expected exactly one matching image, found {count}. "
        "Check deployment.yaml image name."
    )

deployment_file.write_text(updated_content)

print(f"Updated image: {new_image}")
PY

                            git add deployment.yaml

                            if git diff --cached --quiet; then
                                echo "No deployment changes."
                            else
                                git commit -m "Update frontend image to build ${BUILD_NUMBER}"
                                git push origin "HEAD:${GIT_BRANCH}"
                            fi
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Jenkins pipeline completed successfully!'
        }

        failure {
            echo 'Jenkins pipeline failed. Check console output.'
        }
    }
}
